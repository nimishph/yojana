#!/usr/bin/env sh
# yojana for Claude Code. The plugin's bin/ is on the PATH of Claude's Bash tool only, so what runs
# through here acts as the agent (YOJANA_AGENT); pages served by `review --serve` still record the
# person at the page. YOJANA_ACTOR overrides both.
# Runs, in order: the checkout YOJANA_HOME names (development); the source, when the plugin runs in
# place inside a checkout (claude --plugin-dir); otherwise the CLI bundled in lib/, which is what an
# installed plugin uses and needs nothing but Bun.
if ! command -v bun >/dev/null 2>&1; then
  echo "yojana: needs Bun on the PATH (https://bun.sh)" >&2
  exit 2
fi
plugin="$(cd "$(dirname "$0")/.." && pwd)"
export YOJANA_AGENT="${YOJANA_AGENT:-claude}"
if [ -n "${YOJANA_HOME:-}" ]; then
  if [ ! -f "$YOJANA_HOME/cli/src/main.ts" ]; then
    echo "yojana: no yojana checkout at $YOJANA_HOME (no cli/src/main.ts); unset YOJANA_HOME to use the bundled CLI" >&2
    exit 2
  fi
  if [ ! -d "$YOJANA_HOME/node_modules" ]; then
    echo "yojana: dependencies are missing; run bun install in $YOJANA_HOME" >&2
    exit 2
  fi
  exec bun "$YOJANA_HOME/cli/src/main.ts" "$@"
fi
checkout="$(dirname "$plugin")"
if [ -f "$checkout/cli/src/main.ts" ] && [ -d "$checkout/node_modules" ]; then
  exec bun "$checkout/cli/src/main.ts" "$@"
fi
exec bun "$plugin/lib/yojana.js" "$@"
